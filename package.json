{
  "name": "vipercad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:rig": "vite --config rig/vite.config.ts",
    "build": "tsc -b && vite build",
    "build:rig": "vite build --config rig/vite.config.ts",
    "build:all": "npm run build && npm run build:rig",
    "build:exe": "npm run build && node scripts/prepare-desktop.mjs && cd desktop && go build -ldflags=\"-H windowsgui\" -o ../ViperCAD.exe .",
    "lint": "oxlint src rig",
    "ci": "npm test && npm run lint && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@voluma/three-transform-gizmo": "^1.0.0",
    "cad-camera-controls": "^0.2.0",
    "manifold-3d": "^3.5.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
